{
  "functions": {
    "api/analyze.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/review",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard-loader.html"
    },
    {
