{
  "rewrites": [
    { "source": "/review", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/sector-hot?action=refresh",
      "schedule": "0 12 * * 1-5"
    },
    {
      "path": "/api/sector-hot?action=refresh-screener&ai=0",
      "schedule": "0 5 * * 1-5"
    },
    {
      "path": "/api/sector-hot?action=refresh-screener&ai=0",
      "schedule": "0 12 * * 1-5"
    },
    {
      "path": "/api/sector-hot?action=refresh-screener&ai=1",
      "schedule": "10 12 * * 1-5"
    }
  ]
}
