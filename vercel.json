{
  "functions": {
    "api/analyze.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/dashboard",
      "destination": "/dashboard-loader.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/review",
      "destination": "/index.html"
    },
    {
      "source": "/portfolio-planner",
      "destination": "/portfolio-planner.html"
    }
  ],
  "headers": [
    {
      "source": "/dashboard-loader.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/dashboard-approved-access-guard.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/dashboard-approved-enhancements.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/sector-hot?action=telegram-daily-picks",
      "schedule": "0 1 * * 1-5"
    }
  ]
}
