# =========================================================================
# Sample env file for tools/run-telegram-lifecycle.sh — VARIABLE NAMES ONLY.
#
# Setup on the VPS:
#   1. mkdir -p /home/ubuntu/auto-cuan-runner
#   2. cp tools/telegram-lifecycle.env.sample /home/ubuntu/auto-cuan-runner/telegram-lifecycle.env
#   3. Fill in the real values below.
#   4. chmod 600 /home/ubuntu/auto-cuan-runner/telegram-lifecycle.env
#      (the runner REJECTS any group/world access.)
#
# NEVER commit a filled-in copy. NEVER put these secrets in crontab.
# Use ONLY the verification bot token — never TELEGRAM_BOT_TOKEN.
# =========================================================================

# Supabase project URL (service-role endpoint host).
SUPABASE_URL=

# Supabase service-role key (server-only; bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=

# Verification bot token (TELEGRAM_VERIFY_BOT_TOKEN only).
TELEGRAM_VERIFY_BOT_TOKEN=

# Verification channel id (used only by the manual legacy announcement).
TELEGRAM_VERIFY_CHANNEL_ID=
