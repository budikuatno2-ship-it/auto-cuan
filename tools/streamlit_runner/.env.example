# Auto-Cuan Streamlit Runner — Environment Variables
# Copy this file to .env and fill in real values.

# Base URL of your Vercel deployment (Preview or Production)
# Example: https://auto-cuan-abc123.vercel.app
API_BASE_URL=https://your-preview-url.vercel.app

# CRON_SECRET for protected API actions (same as Vercel env)
CRON_SECRET=your-cron-secret-here
