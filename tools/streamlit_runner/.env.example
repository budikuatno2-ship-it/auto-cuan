# Auto-Cuan Streamlit Runner — Environment Variables
# Copy this file to .env and fill in real values.

# Base URL of your Vercel deployment (Preview or Production, no trailing slash)
# Example: https://auto-cuan-abc123.vercel.app
API_BASE_URL=https://your-preview-url.vercel.app

# CRON_SECRET for protected API actions (same as Vercel env variable)
CRON_SECRET=your-cron-secret-here

# Vercel Protection Bypass Token (optional)
# Needed ONLY if your Preview deployment has Vercel Deployment Protection / Authentication enabled.
# Get this from: Vercel Project Settings → Deployment Protection → Protection Bypass for Automation
# Leave empty if your deployment is not protected or if using Production URL.
VERCEL_BYPASS_TOKEN=
