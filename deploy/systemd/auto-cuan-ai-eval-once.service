[Unit]
Description=Auto-Cuan One-Time AI Data Collection Supervisor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/auto-cuan
Environment=NODE_ENV=production
Environment=NODE_BIN=/home/ubuntu/.local/node-v22/bin/node
Environment=AUTO_CUAN_ROOT=/home/ubuntu/auto-cuan
Environment=AI_EVAL_ENV_FILE=/home/ubuntu/auto-cuan/.env.ai-eval-once
EnvironmentFile=/home/ubuntu/auto-cuan/.env.ai-eval-once
ExecStart=/home/ubuntu/.local/node-v22/bin/node /home/ubuntu/auto-cuan/tools/ai-eval-once-supervisor.js
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/auto-cuan-ai-eval /home/ubuntu/auto-cuan

[Install]
WantedBy=multi-user.target
