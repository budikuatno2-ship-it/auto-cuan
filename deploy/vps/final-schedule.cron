# BEGIN AUTO-CUAN FINAL SCHEDULE — 4 PILAR (LIVE vs EOD) — 2026-09-25
# Timezone: Asia/Jakarta (WIB = UTC+7). Semua jam di bawah adalah WIB.
# Live bursa: 09:00-16:00 WIB (02:00-09:00 UTC) — hanya FastWatcher & Daytrade
# EOD malam: 19:00-19:45 WIB (12:00-12:45 UTC) — Swing Konglo, Swing Non-Konglo, Top5/Broker Recap
CRON_TZ=Asia/Jakarta

# ── INFRA HARIAN ──────────────────────────────────────────────────────────
# Backfill candle historis (tengah malam)
5 0 * * * /home/ubuntu/.local/node-v22/bin/node /home/ubuntu/auto-cuan/tools/backfill-historical-candles.js --max-requests=2500 >> /home/ubuntu/auto-cuan-runner/logs/backfill-candles.log 2>&1
# Lifecycle evaluator (sore, setelah bursa tutup)
30 16 * * 1-5 /home/ubuntu/.local/node-v22/bin/node /home/ubuntu/auto-cuan/tools/run-lifecycle-evaluator.js --apply >> /home/ubuntu/auto-cuan-runner/logs/lifecycle-evaluator.log 2>&1
# Broker summary update (18:00 WIB, retry tiap 30 menit sampai 22:00 via wrapper)
0 18 * * 1-5 /home/ubuntu/auto-cuan/deploy/vps/run-daily-broker-update.sh --limit 5000 --fresh >> /home/ubuntu/auto-cuan-runner/logs/daily-broker-update.log 2>&1
# Afternoon recap (18:45 WIB)
45 18 * * 1-5 /home/ubuntu/auto-cuan/deploy/vps/run-daily-afternoon-recap.sh --send >> /home/ubuntu/auto-cuan-runner/logs/daily-afternoon-recap.log 2>&1
# Fetch daily candles (19:30 WIB, setelah broker settle)
30 19 * * 1-5 /home/ubuntu/.local/node-v22/bin/node /home/ubuntu/auto-cuan/tools/fetch-daily-candles.js >> /home/ubuntu/auto-cuan-runner/logs/fetch-daily-candles.log 2>&1
# Landing refresh (22:15 WIB, harian)
15 22 * * * /home/ubuntu/.local/node-v22/bin/node /home/ubuntu/auto-cuan/tools/direct-refresh-landing.js >> /home/ubuntu/auto-cuan-runner/logs/landing-refresh.log 2>&1

# ── LIVE BURSA (Senin-Jumat, 09:00-16:00 WIB) ────────────────────────────
# FASTWATCHER LIVE: setiap 5 menit selama jam bursa aktif (menangkap spike volume mendadak)
# WIB 09:00-15:59 = UTC 02:00-08:59 → dengan CRON_TZ=Asia/Jakarta cukup 9-15
*/5 9-15 * * 1-5 /home/ubuntu/auto-cuan/deploy/vps/run-fastwatcher.sh --send >> /home/ubuntu/auto-cuan-runner/logs/fastwatcher.log 2>&1
# DAYTRADE SCREENER: pembukaan & pertengahan sesi (09:15, 10:30, 13:45 WIB)
15 9 * * 1-5 /home/ubuntu/auto-cuan/deploy/vps/run-daytrade.sh --send >> /home/ubuntu/auto-cuan-runner/logs/daytrade.log 2>&1
30 10 * * 1-5 /home/ubuntu/auto-cuan/deploy/vps/run-daytrade.sh --send >> /home/ubuntu/auto-cuan-runner/logs/daytrade.log 2>&1
45 13 * * 1-5 /home/ubuntu/auto-cuan/deploy/vps/run-daytrade.sh --send >> /home/ubuntu/auto-cuan-runner/logs/daytrade.log 2>&1

# ── PRODUCER SCREENER (Full universe sweep via VPS daemon + Snapshot) ────
# Berjalan 19:00 WIB (selesai ~19:07 WIB) menghasilkan data/screener-latest.json sebelum consumer berjalan
0 19 * * 1-5 /home/ubuntu/auto-cuan/deploy/vps/run-screeners.sh --execute --send >> /home/ubuntu/auto-cuan-runner/logs/screeners.log 2>&1

# ── END-OF-DAY / MALAM (Senin-Jumat, 19:00-19:45 WIB) ─────────────────────
# SWING KONGLOMERAT: 19:15 WIB — setelah data broker summary resmi lengkap & snapshot ready
15 19 * * 1-5 /home/ubuntu/auto-cuan/deploy/vps/run-swing-konglo.sh --send >> /home/ubuntu/auto-cuan-runner/logs/swing-konglo.log 2>&1
# SWING NON-KONGLOMERAT: 19:30 WIB
30 19 * * 1-5 /home/ubuntu/auto-cuan/deploy/vps/run-swing-non-konglo.sh --send >> /home/ubuntu/auto-cuan-runner/logs/swing-non-konglo.log 2>&1
# TOP 5 & BROKER SUMMARY REKAP + SCREENER DISPATCH: 19:45 WIB (skip_market_guard=true)
45 19 * * 1-5 /home/ubuntu/auto-cuan/deploy/vps/run-screener-dispatch.sh --send >> /home/ubuntu/auto-cuan-runner/logs/screener-dispatch.log 2>&1

# ── HYBRID WEBHOOK FAILOVER — DINONAKTIFKAN (2026-09-25) ────────────────
# Verifikasi bot sekarang memakai LONG POLLING mandiri via PM2
# (autocuan-verify-bot, entry: tools/telegram-verify-bot.js). Tidak ada lagi
# webhook Vercel (HTTP 402) maupun cloudflared tunnel yang bisa mati.
#
# PENTING: JANGAN aktifkan kembali baris di bawah. Failover ini akan
# memasang ulang webhook dan mematikan polling (getUpdates → 409 Conflict).
# Untuk mengembalikan mode webhook: pm2 delete autocuan-verify-bot lalu
# buka komentar baris ini.
# */10 * * * * /home/ubuntu/auto-cuan/deploy/vps/run-webhook-failover.sh >> /home/ubuntu/auto-cuan-runner/logs/webhook-failover.log 2>&1

# ── HYBRID SECTOR HOT (Vercel primer → runner lokal VPS) ────────────────
# Pemicu endpoint Vercel dulu; jika response bukan HTTP 200, runner lokal
# (tools/run-screener.js) dieksekusi mandiri agar snapshot sektor tetap segar.
*/30 9-15 * * 1-5 /home/ubuntu/auto-cuan/deploy/vps/run-sector-hot.sh >> /home/ubuntu/auto-cuan-runner/logs/sector-hot.log 2>&1

# ── ORACLE ANTI-SUSPEND KEEP-ALIVE (ringan, setiap jam) ──────────────────
# Sanitasi cache kadaluarsa + hash audit + heartbeat — <1s, <10MB, menjaga CPU p95 >20%
0 * * * * /home/ubuntu/auto-cuan/deploy/vps/run-keepalive.sh >> /home/ubuntu/auto-cuan-runner/logs/keepalive.log 2>&1

# Watchdog long-polling verifikasi bot (auto-restart bila stall/mati)
*/5 * * * * /home/ubuntu/auto-cuan/deploy/vps/check-verify-poller.sh >> /home/ubuntu/auto-cuan-runner/logs/verify-poller-watchdog.log 2>&1

# END AUTO-CUAN FINAL SCHEDULE
