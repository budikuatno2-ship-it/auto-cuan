# =========================================================================
# Configuration for VPS Local Telegram Monitor Runner
#
# Setup on the VPS:
#   1. mkdir -p /home/ubuntu/auto-cuan-runner
#   2. cp deploy/vps/telegram-monitor.env.example /home/ubuntu/auto-cuan-runner/.env
#   3. Fill in the real credentials.
#   4. chmod 600 /home/ubuntu/auto-cuan-runner/.env
#
# NEVER commit filled-in credentials into Git repository.
# =========================================================================

# Supabase URL & Service Role Key (bypasses RLS for backend monitor)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cron authorization secret
CRON_SECRET=your-cron-secret

# Production live monitoring approval
# Set to YES to allow live evaluation, state persistence, and Telegram alerts
LOCAL_MONITOR_LIVE_APPROVED=YES
