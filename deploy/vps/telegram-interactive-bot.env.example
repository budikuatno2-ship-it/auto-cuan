# Telegram Interactive Bot — required variables
# Copy this file to /home/ubuntu/auto-cuan/.env.bot and fill in the secrets.
# Then add the following line to .env (or load it before starting):
#   source .env.bot

# Required: Telegram bot token (from @BotFather)
BOT_TOKEN=

# Required: Your Telegram user ID (get it from @userinfobot)
ADMIN_TELEGRAM_ID=

# Required: Username of the verification bot (without @)
VERIFY_BOT_USERNAME=AutoCuanVerifyBot

# Required: Group ID for member discussion and interactive commands (e.g. -1001234567890)
# This is the GROUP environment where /analisa, /broksum, /tanya commands work
# DILARANG dialihkan ke grup - sinyal broadcast harus tetap di channel terpisah
BOT_GROUP_ID=-1003755658635

# Required: Supabase project URL (already in .env.intraday-runtime)
# SUPABASE_URL=https://evyczgtnufypyidxxtqf.supabase.co

# Required: Supabase service role key (already in .env.intraday-runtime)
# SUPABASE_SERVICE_ROLE_KEY=<from Supabase dashboard>

# Optional: Public base URL for one-time webview links (e.g. https://bot.example.com)
BOT_PUBLIC_BASE_URL=

# Optional: Port for local webview HTTP server (default: 3010)
BOT_WEBVIEW_PORT=3010

# Optional: Custom AI provider base URL (e.g. https://api.openai.com/v1)
CUSTOM_AI_BASE_URL=
