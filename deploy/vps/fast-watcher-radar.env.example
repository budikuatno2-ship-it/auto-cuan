# Fast Watcher radar Telegram output — required kill switches (2026-10-13).
#
# All four switches must be "1" for the pre-confirmation radar publisher
# (lib/intraday-fast-watcher-radar-publisher.js) to broadcast to Telegram.
# Production evidence: FAST_WATCHER_RADAR_TELEGRAM_ENABLED was never set on
# the VPS runner, so publishRadar() returned radar_kill_switch_off on every
# tick and the radar output stayed dark.
#
# Apply to /home/ubuntu/auto-cuan-runner/.env:
#   FAST_WATCHER_LIVE_ENABLED=1
#   FAST_WATCHER_PUBLISH_ENABLED=1
#   FAST_WATCHER_TELEGRAM_ENABLED=1
#   FAST_WATCHER_RADAR_TELEGRAM_ENABLED=1
#
# Optional: allow pre-confirmation radar cards (default OFF; only for
# controlled observability, never for production channel hygiene).
# FAST_WATCHER_RADAR_ALLOW_PRECONFIRMATION_TELEGRAM=0

FAST_WATCHER_LIVE_ENABLED=1
FAST_WATCHER_PUBLISH_ENABLED=1
FAST_WATCHER_TELEGRAM_ENABLED=1
FAST_WATCHER_RADAR_TELEGRAM_ENABLED=1
