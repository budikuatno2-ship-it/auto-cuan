# Copy to /home/ubuntu/auto-cuan/.env.ai-eval-once on the VPS.
# chmod 600 the real file. Never commit the real values.

AI_EVAL_API_KEY=REPLACE_ON_VPS_ONLY
AI_EVAL_BASE_URL=https://openagentic.id/api/v1
AI_EVAL_MODEL=claude-sonnet-4.6
AI_EVAL_STORAGE_BUCKET=ai-eval-private

SUPABASE_URL=REPLACE_ON_VPS_ONLY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ON_VPS_ONLY

AI_EVAL_WORK_DIR=/home/ubuntu/auto-cuan-ai-eval
AI_EVAL_SOURCE_JSONL=/home/ubuntu/auto-cuan-ai-eval/context-snapshots-budi.jsonl
AI_EVAL_DATASET_GZ=/home/ubuntu/auto-cuan-ai-eval/dataset-complete-v2.jsonl.gz
AI_EVAL_OUTPUT_DIR=/home/ubuntu/auto-cuan-ai-eval/output
AI_EVAL_SUPERVISOR_POLL_MS=10000

# Quality-first upper bound. Generation stops earlier if useful unique variations run out.
AI_EVAL_CASE_TARGET=1000000
AI_EVAL_MAX_DUPLICATE_STREAK=50000

# Initial hard budget. Increase deliberately after provider credit is topped up, then resume.
AI_EVAL_TOKEN_BUDGET=50000000
