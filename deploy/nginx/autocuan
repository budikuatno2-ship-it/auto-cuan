# Auto-Cuan Nginx Reverse Proxy — VPS 168.110.221.197
# Path di VPS: /etc/nginx/sites-available/autocuan
# Symlink: ln -s /etc/nginx/sites-available/autocuan /etc/nginx/sites-enabled/autocuan
#
# Prasyarat:
#   - Origin web berjalan di 127.0.0.1:3000 (PM2: autocuan-web)
#   - VPS API bridge di 127.0.0.1:3001 (PM2: auto-cuan-vps-api) — tidak dipublish via Nginx
#
# Fitur:
#   - Reverse proxy 80/443 -> 127.0.0.1:3000
#   - Header proxy standar (Host, X-Real-IP, X-Forwarded-For, X-Forwarded-Proto)
#   - WebSocket support (Upgrade, Connection "upgrade")
#   - Gzip untuk aset statis
#   - Security headers (mirror vercel.json)
#   - Rate limit ringan untuk /api/*

limit_req_zone $binary_remote_addr zone=autocuan_api:10m rate=10r/s;

upstream autocuan_web {
    server 127.0.0.1:3000 max_fails=3 fail_timeout=30s;
    keepalive 32;
}

# HTTP — redirect ke HTTPS (jika sertifikat sudah terpasang via certbot)
# Jika belum ada sertifikat, Nginx tetap melayani HTTP langsung (hapus return 301).
server {
    listen 80;
    listen [::]:80;
    server_name autocuan.web.id www.autocuan.web.id 168.110.221.197;

    # Let's Encrypt challenge
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    # Sementara belum ada TLS, layani langsung via proxy.
    # Setelah certbot --nginx berhasil, ganti blok ini menjadi redirect:
    #   return 301 https://$host$request_uri;

    # --- Reverse proxy ke origin web ---
    location / {
        proxy_pass http://autocuan_web;
        proxy_http_version 1.1;

        # Header proxy standar
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        # WebSocket
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Timeouts
        proxy_connect_timeout 10s;
        proxy_send_timeout 30s;
        proxy_read_timeout 60s;

        # Buffering
        proxy_buffering on;
        proxy_buffer_size 8k;
        proxy_buffers 8 16k;

        # Keepalive
        proxy_set_header Connection "";
    }

    # API — rate limit + no-cache
    location /api/ {
        limit_req zone=autocuan_api burst=20 nodelay;

        proxy_pass http://autocuan_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Jangan cache API
        add_header Cache-Control "private, no-store, no-cache, must-revalidate, max-age=0" always;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
    }

    # Aset statis — cache + gzip
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|webp|woff|woff2|ttf|eot)$ {
        proxy_pass http://autocuan_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        expires 7d;
        add_header Cache-Control "public, max-age=604800, immutable" always;
        access_log off;
    }

    # Gzip
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_buffers 16 8k;
    gzip_http_version 1.1;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/javascript
        application/json
        application/xml
        application/xml+rss
        image/svg+xml
        font/woff
        font/woff2;

    # Security headers
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-DNS-Prefetch-Control "off" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;

    access_log /var/log/nginx/autocuan_access.log;
    error_log /var/log/nginx/autocuan_error.log warn;
}

